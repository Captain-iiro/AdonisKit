# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_NAME=AdonisKit
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Mail
MAIL_MAILER=dev
MAIL_FROM_ADDRESS=no-reply@localhost
MAIL_FROM_NAME='No Reply'
# SMTP_* is disabled by default. To send real emails, uncomment the
# block below and set MAIL_MAILER=smtp.
# SMTP_HOST=localhost
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Demo
# Create a demo account (demo@adoniskit.dev / password) with:
#   node ace db:seed